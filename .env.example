# Environment variables for the *terminal* UI (main.py) and the CLI tools,
# which resolve models through the built-in registry and read keys from here.
#
# The *web* UI does not use this file: it reads providers.json, which you edit
# in Settings -> Providers.  See the README for the split.
#
# Copy to `.env` and fill in what you have.  Any seat whose key is missing falls
# back to a local heuristic brain, so the game always runs either way.

# ---- DeepSeek (official) ---------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Which DeepSeek model each registry entry points at.  `deepseek-flash` is a
# reasoning model: it emits a hidden chain-of-thought in `reasoning_content`
# before the answer, so it needs a generous token budget (the arena already
# sends max_tokens=4000 for it).
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ---- Volcengine Ark (DeepSeek / Doubao hosted) -----------------------------
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=deepseek-v3-250324
# DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# ---- OpenAI (or any OpenAI-compatible relay) -------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ---- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Force plain-ASCII card rendering (useful on GBK/CP1252 Windows consoles).
# POKERARENA_ASCII=1
